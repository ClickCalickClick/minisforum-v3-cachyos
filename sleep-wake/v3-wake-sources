#!/bin/sh
# Minisforum V3: only the power button should wake the machine from sleep.
# In a bag, the folded keyboard cover, the touchscreen, a shifting cover
# (lid switch) or a charger blip could wake s2idle. Applied right before each
# sleep, so driver probe order and usbhid re-enabling wakeup don't matter.
[ "$1" = pre ] || exit 0

for dev in /sys/bus/i2c/devices/i2c-PNP0C50:00 \
           /sys/bus/platform/devices/PNP0C0D:00 \
           /sys/class/power_supply/ACAD; do
    [ -w "$dev/power/wakeup" ] && echo disabled > "$dev/power/wakeup"
done

# Keyboard cover (USB 05af:326a)
for dev in /sys/bus/usb/devices/*; do
    [ "$(cat "$dev/idVendor" 2>/dev/null):$(cat "$dev/idProduct" 2>/dev/null)" = 05af:326a ] &&
        echo disabled > "$dev/power/wakeup"
done
exit 0
